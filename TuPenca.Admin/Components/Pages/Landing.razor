@page "/"
@layout LandingLayout

<div class="landing-page">
    <header class="landing-header">
        <div class="brand">
            <span class="brand-logo">TP</span>
            <span class="brand-name">TuPenca</span>
        </div>

        <a class="login-button" href="/login-admin">Login admin</a>
    </header>

    <main class="landing-main">
        <section class="hero-card">
            <div class="hero-content">
                <h1>Organizá tu penca online</h1>

                <p>
                    TuPenca es una plataforma para crear sitios de pencas personalizados,
                    gestionar usuarios, competencias, predicciones y rankings.
                </p>

                <a class="primary-button" href="/solicitar-sitio">
                    Crear mi sitio
                </a>
            </div>
        </section>

        <section class="hero-background">
            <h2>Tu sitio, tus usuarios, tu penca</h2>
            <p>
                Solicitá tu propio sitio y comenzá a administrar tus pencas de forma simple.
            </p>
        </section>
    </main>

    <footer class="landing-footer">
        Proyecto académico - TuPenca
    </footer>
</div>