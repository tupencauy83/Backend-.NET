@page "/"
@rendermode InteractiveServer
@layout TuPenca.Admin.Components.Layout.PublicLayout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using TuPenca.Admin.Helpers

<div class="public-landing-page">
    <header class="public-landing-header">
        <div class="public-brand">
            <span class="public-brand-logo">TP</span>
            <span class="public-brand-name">TuPenca</span>
        </div>

        <a class="public-login-button" href="/login-admin">Login admin</a>
    </header>

    <main class="public-landing-main">
        <section class="public-hero-card">
            <div class="public-hero-content">
                <h1>Organizá tu penca online</h1>

                <p>
                    TuPenca es una plataforma para crear sitios de pencas personalizados,
                    gestionar usuarios, competencias, predicciones y rankings.
                </p>

                <a class="public-button-primary" href="/solicitar-sitio">
                    Crear mi sitio
                </a>
            </div>
        </section>

        <section class="public-hero-background">
            <h2>Tu sitio, tus usuarios, tu penca</h2>
            <p>
                Solicitá tu propio sitio y comenzá a administrar tus pencas de forma simple.
            </p>
        </section>
    </main>

    <footer class="public-landing-footer">
        Proyecto académico - TuPenca
    </footer>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "adminToken");
        var rol = await JS.InvokeAsync<string>("localStorage.getItem", "adminRol");

        if (!string.IsNullOrWhiteSpace(token) &&
            rol == "AdministradorPlataforma" &&
            !JwtTokenHelper.TokenExpirado(token))
        {
            Navigation.NavigateTo("/estadisticas", forceLoad: true);
        }
    } 
}