@page "/plantillas"
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Plantillas
@using TuPenca.Admin.DTOs.Evento
@inject PlantillasApiClient PlantillasApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<div class="workflow-page">
    <p class="workflow-breadcrumb">
        <a href="/eventos">Competencias</a>
        @if (eventoSeleccionado != null)
        {
            <text> · <a href="/eventos/@eventoSeleccionado.Id/resultados">@eventoSeleccionado.Nombre</a></text>
        }
        · Paso 3 de 3
    </p>

    <h1>Plantillas de penca</h1>
    <p class="workflow-page__intro">
        La plantilla define las reglas de puntaje, el monto de entrada y la comisión.
        Los administradores de sitio la usan para instanciar pencas sobre este evento.
    </p>

    <CompetenciaFlujoStepper PasoActual="3"
                             EventoId="eventoSeleccionado?.Id"
                             EventoNombre="@eventoSeleccionado?.Nombre" />

    @if (mensajeExito != null)
    {
        <div class="workflow-banner">@((MarkupString)mensajeExito)</div>
    }

@if (VerificandoSesion)
{
    <p>Verificando sesión...</p>
}
else
{
    <button class="btn btn-primary" @onclick="ToggleFormulario">
        @(mostrarForm ? "Cancelar" : "+ Nueva plantilla")
    </button>

    @if (mostrarForm)
    {
        <div class="form-card">
            <h2 class="stats-section-title">Paso 3 · Configurar plantilla</h2>

            <div class="form-group">
                <label>Nombre</label>
                <input @bind="form.Nombre" placeholder="Ej: Mundial 2026 - estándar" required />
            </div>

            <div class="form-group">
                <label>Descripción</label>
                <textarea @bind="form.Descripcion" rows="2" placeholder="Breve descripción para el admin de sitio" required></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Tiempo límite (minutos antes del partido)</label>
                    <input type="number" min="1" @bind="form.TiempoLimitePrevioMinutos" />
                    <span class="form-hint">Hasta cuántos minutos antes se pueden cargar predicciones</span>
                </div>

                <div class="form-group">
                    <label>Evento deportivo</label>
                    <select @bind="form.EventoDeportivoId">
                        <option value="@Guid.Empty">Seleccionar...</option>
                        @foreach (var ev in eventos)
                        {
                            <option value="@ev.Id">@ev.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Monto de entrada ($)</label>
                    <input type="number" min="0" @bind="form.MontoEntrada" />
                </div>

                <div class="form-group">
                    <label>Comisión plataforma (%)</label>
                    <input type="number" min="0" max="49" @bind="form.PorcentajeComision" />
                </div>
            </div>

            <div class="form-group">
                <label>Puntos extra por acertar ganador</label>
                <input type="number" min="0" @bind="form.PuntajeGanador" />
                <span class="form-hint">Puntos adicionales si el usuario acierta quién gana el partido</span>
            </div>

            <label style="font-weight:600;margin-bottom:.5rem;display:block;">Reglas de puntuación</label>
            <p class="form-hint" style="margin-bottom:.75rem;">
                Desviación = diferencia total de goles respecto al resultado real. Ej: exacto = 0 desviación.
            </p>

            @for (int i = 0; i < form.Reglas.Count; i++)
            {
                var idx = i;

                <div style="display:flex;gap:.5rem;margin-bottom:.5rem;align-items:end;">
                    <div class="form-group" style="margin-bottom:0;flex:1;">
                        <label style="font-size:.75rem;">Desviación</label>
                        <input type="number" min="0" @bind="form.Reglas[idx].Desviacion" />
                    </div>

                    <div class="form-group" style="margin-bottom:0;flex:1;">
                        <label style="font-size:.75rem;">Puntaje</label>
                        <input type="number" min="0" @bind="form.Reglas[idx].Puntaje" />
                    </div>

                    <button type="button" class="btn btn-danger" @onclick="() => form.Reglas.RemoveAt(idx)">✕</button>
                </div>
            }

            <button type="button"
                    class="btn"
                    style="background:var(--border);margin-bottom:1rem;"
                    @onclick="() => form.Reglas.Add(new ReglaPuntuacionDto())">
                + Agregar regla
            </button>

            @if (formError != null)
            {
                <p class="error">@formError</p>
            }

            <button class="btn btn-primary" @onclick="Crear" disabled="@saving">
                @(saving ? "Creando..." : "Crear plantilla")
            </button>
        </div>
    }

    @if (errorGeneral != null)
    {
        <p class="error">@errorGeneral</p>
    }

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else
    {
        <table class="table" style="margin-top:1.5rem;">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Evento</th>
                    <th>Límite (min)</th>
                    <th>Monto</th>
                    <th>Reglas</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pl in plantillasFiltradas)
                {
                    <tr>
                        <td>@pl.Nombre</td>
                        <td>@pl.EventoDeportivo</td>
                        <td>@pl.TiempoLimitePrevioMinutos</td>
                        <td>$@pl.MontoEntrada</td>
                        <td>@(pl.Reglas?.Count ?? 0)</td>
                        <td>
                            <button class="btn btn-danger" @onclick="() => Eliminar(pl.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!plantillasFiltradas.Any())
        {
            <p class="empty">
                @if (EventoIdQuery.HasValue)
                {
                    <text>No hay plantillas para este evento todavía.</text>
                }
                else
                {
                    <text>No hay plantillas registradas.</text>
                }
            </p>
        }
    }

    <div style="margin-top: 1rem;">
        <a href="/eventos" style="color: var(--primary);">← Volver a competencias</a>
    </div>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "eventoId")]
    public Guid? EventoIdQuery { get; set; }

    private List<PlantillaResponseDto> plantillas = new();
    private List<CatalogoSimpleDto> eventos = new();
    private CatalogoSimpleDto? eventoSeleccionado;

    private bool loading = true;
    private bool saving = false;
    private bool mostrarForm = false;

    private string? formError;
    private string? errorGeneral;
    private string? mensajeExito;

    private PlantillaRequestDto form = CrearFormularioInicial();

    private IEnumerable<PlantillaResponseDto> plantillasFiltradas =>
        EventoIdQuery.HasValue
            ? plantillas.Where(p => p.EventoDeportivoId == EventoIdQuery.Value)
            : plantillas;

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();

        if (EventoIdQuery.HasValue && EventoIdQuery.Value != Guid.Empty)
        {
            form.EventoDeportivoId = EventoIdQuery.Value;
            eventoSeleccionado = eventos.FirstOrDefault(e => e.Id == EventoIdQuery.Value);
            mostrarForm = true;
        }
    }

    private void ToggleFormulario() => mostrarForm = !mostrarForm;

    private async Task Cargar()
    {
        PlantillasApiClient.SetToken(AdminToken!);

        plantillas = await PlantillasApiClient.ObtenerTodosAsync();
        eventos = await PlantillasApiClient.ObtenerEventosAsync();
        loading = false;
    }

    private async Task Crear()
    {
        saving = true;
        formError = null;

        try
        {
            PlantillasApiClient.SetToken(AdminToken!);

            if (string.IsNullOrWhiteSpace(form.Nombre))
            {
                formError = "El nombre de la plantilla es obligatorio.";
                return;
            }

            if (string.IsNullOrWhiteSpace(form.Descripcion))
            {
                formError = "La descripción de la plantilla es obligatoria.";
                return;
            }

            if (form.EventoDeportivoId == Guid.Empty)
            {
                formError = "Seleccioná un evento deportivo.";
                return;
            }

            if (!form.Reglas.Any())
            {
                formError = "Agregá al menos una regla de puntuación.";
                return;
            }

            var nueva = await PlantillasApiClient.CrearAsync(form);

            plantillas.Add(nueva);
            eventoSeleccionado = eventos.FirstOrDefault(e => e.Id == nueva.EventoDeportivoId);

            var nombreEvento = eventoSeleccionado?.Nombre ?? "el evento";
            mensajeExito =
                $"<strong>Plantilla creada.</strong> Los sitios ya pueden instanciar pencas de «{nombreEvento}». " +
                $"<a href=\"/eventos\">Ver competencias</a>";

            form = CrearFormularioInicial();
            if (EventoIdQuery.HasValue)
                form.EventoDeportivoId = EventoIdQuery.Value;

            mostrarForm = false;
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Eliminar(Guid id)
    {
        try
        {
            PlantillasApiClient.SetToken(AdminToken!);

            await PlantillasApiClient.EliminarAsync(id);
            plantillas.RemoveAll(p => p.Id == id);
            errorGeneral = null;
        }
        catch (Exception ex)
        {
            errorGeneral = ex.Message;
        }
    }

    private static PlantillaRequestDto CrearFormularioInicial()
    {
        return new PlantillaRequestDto
        {
            TiempoLimitePrevioMinutos = 60,
            MontoEntrada = 100,
            PorcentajeComision = 10,
            PuntajeGanador = 2,
            Reglas = new()
            {
                new ReglaPuntuacionDto
                {
                    Desviacion = 0,
                    Puntaje = 3
                }
            }
        };
    }
}
