@page "/estadisticas"
@using System.Globalization
@using System.Text
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Estadisticas
@using TuPenca.Admin.Models.Enums
@inject EstadisticasApiClient EstadisticasApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer
@implements IDisposable

<div class="stats-page">
    <h1>Estadísticas globales</h1>

    @if (VerificandoSesion)
    {
        <p>Verificando sesión...</p>
    }
    else
    {
        <div class="form-card stats-filtros">
            <div class="stats-filtros__header">
                <div>
                    <h2 class="stats-filtros__title">Parámetros de búsqueda</h2>
                    <p class="stats-filtros__resumen">@ResumenFiltrosActivos()</p>
                </div>
                <div class="stats-filtros__actions">
                    @if (loading)
                    {
                        <span class="stats-filtros__loading">Actualizando...</span>
                    }
                    @if (HayFiltrosActivos)
                    {
                        <button type="button" class="btn btn-outline btn-sm" @onclick="LimpiarFiltros" disabled="@loading">
                            Limpiar
                        </button>
                    }
                </div>
            </div>

            <div class="stats-filtros__grid">
                <div class="form-group">
                    <label for="buscarSitio">Buscar sitio</label>
                    <input id="buscarSitio" type="search" placeholder="Nombre o dominio..."
                           value="@buscarSitio" @oninput="OnBuscarInput" />
                    <span class="form-hint">Se aplica al escribir (con una breve pausa)</span>
                </div>

                <div class="form-group">
                    <label for="estadoSitio">Estado del sitio</label>
                    <select id="estadoSitio" @bind="estadoSitioStr" @bind:after="OnFiltroServidorChanged">
                        <option value="">Todos</option>
                        <option value="0">Activo</option>
                        <option value="1">Inactivo</option>
                        <option value="2">Pendiente</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="fechaDesde">Pagos desde</label>
                    <input id="fechaDesde" type="date" value="@fechaDesdeStr" @onchange="OnFechaDesdeChanged" />
                </div>

                <div class="form-group">
                    <label for="fechaHasta">Pagos hasta</label>
                    <input id="fechaHasta" type="date" value="@fechaHastaStr" @onchange="OnFechaHastaChanged" />
                </div>

                <div class="form-group">
                    <label for="minUsuarios">Mín. usuarios</label>
                    <input id="minUsuarios" type="number" min="0" placeholder="Ej: 10"
                           @bind="minUsuariosStr" />
                    <span class="form-hint">Filtro instantáneo sobre la tabla</span>
                </div>

                <div class="form-group">
                    <label for="orden">Ordenar por</label>
                    <select id="orden" @bind="orden">
                        <option value="recaudado">Recaudación</option>
                        <option value="usuarios">Usuarios</option>
                        <option value="inscripciones">Inscripciones</option>
                        <option value="pencasActivas">Pencas activas</option>
                        <option value="nombre">Nombre</option>
                    </select>
                </div>
            </div>
        </div>

        @if (error != null)
        {
            <p class="error">@error</p>
        }
        else if (loading && stats == null)
        {
            <p>Cargando...</p>
        }
        else if (stats != null)
        {
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Sitios</span>
                    <span class="kpi-value">@stats.TotalSitios</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Usuarios</span>
                    <span class="kpi-value">@stats.TotalUsuarios</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Pencas activas</span>
                    <span class="kpi-value">@stats.TotalPencasActivas</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Pencas finalizadas</span>
                    <span class="kpi-value">@stats.TotalPencasFinalizadas</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Recaudado</span>
                    <span class="kpi-value">@FormatearMoneda(stats.TotalRecaudado)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Comisiones</span>
                    <span class="kpi-value">@FormatearMoneda(stats.TotalComisionesGeneradas)</span>
                </div>
            </div>

            @if (Insights.Any())
            {
                <div class="stats-insights">
                    @foreach (var insight in Insights)
                    {
                        <div class="stats-insight">@insight</div>
                    }
                </div>
            }

            <div class="stats-tops">
                <div class="form-card">
                    <h3 class="stats-section-title">Top sitios por usuarios</h3>
                    @if (stats.TopSitiosPorUsuarios.Count == 0)
                    {
                        <p class="empty">Sin datos para mostrar.</p>
                    }
                    else
                    {
                        <ol class="stats-top-list">
                            @foreach (var item in stats.TopSitiosPorUsuarios)
                            {
                                <li>
                                    <span class="stats-top-name">@item.NombreSitio</span>
                                    <span class="stats-top-value">@item.Valor usuarios</span>
                                </li>
                            }
                        </ol>
                    }
                </div>

                <div class="form-card">
                    <h3 class="stats-section-title">Top sitios por recaudación</h3>
                    @if (stats.TopSitiosPorRecaudacion.Count == 0)
                    {
                        <p class="empty">Sin datos para mostrar.</p>
                    }
                    else
                    {
                        <ol class="stats-top-list">
                            @foreach (var item in stats.TopSitiosPorRecaudacion)
                            {
                                <li>
                                    <span class="stats-top-name">@item.NombreSitio</span>
                                    <span class="stats-top-value">@FormatearMoneda(item.Valor)</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </div>

            <div class="stats-table-header">
                <h2>Detalle por sitio</h2>
                <button type="button" class="btn btn-outline btn-sm" @onclick="ExportarCsv" disabled="@(!SitiosTabla.Any())">
                    Exportar CSV
                </button>
            </div>

            @if (SitiosTabla.Count == 0)
            {
                <p class="empty">No hay sitios que coincidan con los filtros.</p>
            }
            else
            {
                <div class="stats-table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sitio</th>
                                <th>Dominio</th>
                                <th>Estado</th>
                                <th>Usuarios</th>
                                <th>Pendientes</th>
                                <th>Pencas act.</th>
                                <th>Pencas fin.</th>
                                <th>Inscripciones</th>
                                <th>Recaudado</th>
                                <th>Comisiones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sitio in SitiosTabla)
                            {
                                <tr>
                                    <td>@sitio.NombreSitio</td>
                                    <td>@sitio.UrlPropia</td>
                                    <td><span class="badge @BadgeEstado(sitio.Estado)">@EtiquetaEstado(sitio.Estado)</span></td>
                                    <td>@sitio.TotalUsuarios</td>
                                    <td>@sitio.UsuariosPendientes</td>
                                    <td>@sitio.TotalPencasActivas</td>
                                    <td>@sitio.TotalPencasFinalizadas</td>
                                    <td>@sitio.TotalInscripciones</td>
                                    <td>@FormatearMoneda(sitio.TotalRecaudado)</td>
                                    <td>@FormatearMoneda(sitio.TotalComisiones)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    private EstadisticasGlobalesDto? stats;
    private bool loading = true;
    private string? error;

    private string buscarSitio = string.Empty;
    private string estadoSitioStr = string.Empty;
    private string fechaDesdeStr = string.Empty;
    private string fechaHastaStr = string.Empty;
    private string minUsuariosStr = string.Empty;
    private string orden = "recaudado";

    private CancellationTokenSource? _debounceCts;
    private bool _filtrosInicializados;

    private bool HayFiltrosActivos =>
        !string.IsNullOrWhiteSpace(buscarSitio) ||
        !string.IsNullOrWhiteSpace(estadoSitioStr) ||
        !string.IsNullOrWhiteSpace(fechaDesdeStr) ||
        !string.IsNullOrWhiteSpace(fechaHastaStr) ||
        !string.IsNullOrWhiteSpace(minUsuariosStr) ||
        orden != "recaudado";

    private int MinUsuarios =>
        int.TryParse(minUsuariosStr, out var n) && n > 0 ? n : 0;

    private List<EstadisticaSitioDetalleDto> SitiosTabla
    {
        get
        {
            if (stats?.EstadisticasPorSitio == null)
                return new();

            IEnumerable<EstadisticaSitioDetalleDto> query = stats.EstadisticasPorSitio;

            if (MinUsuarios > 0)
                query = query.Where(s => s.TotalUsuarios >= MinUsuarios);

            query = orden switch
            {
                "usuarios" => query.OrderByDescending(s => s.TotalUsuarios).ThenBy(s => s.NombreSitio),
                "inscripciones" => query.OrderByDescending(s => s.TotalInscripciones).ThenBy(s => s.NombreSitio),
                "pencasActivas" => query.OrderByDescending(s => s.TotalPencasActivas).ThenBy(s => s.NombreSitio),
                "nombre" => query.OrderBy(s => s.NombreSitio),
                _ => query.OrderByDescending(s => s.TotalRecaudado).ThenBy(s => s.NombreSitio)
            };

            return query.ToList();
        }
    }

    private IEnumerable<string> Insights
    {
        get
        {
            if (stats == null || stats.TotalSitios == 0)
                yield break;

            var promedio = stats.TotalSitios > 0
                ? stats.TotalRecaudado / (double)stats.TotalSitios
                : 0;

            yield return $"Promedio de recaudación por sitio: {FormatearMoneda((int)Math.Round(promedio))}.";

            var top = stats.TopSitiosPorRecaudacion.FirstOrDefault();
            if (top != null && top.Valor > 0)
                yield return $"Mayor recaudación: {top.NombreSitio} ({FormatearMoneda(top.Valor)}).";

            if (stats.TotalUsuarios > 0)
            {
                var inscripciones = stats.EstadisticasPorSitio.Sum(s => s.TotalInscripciones);
                if (inscripciones > 0)
                {
                    var ratio = inscripciones / (double)stats.TotalUsuarios;
                    yield return $"Ratio inscripciones/usuario: {ratio:0.##}.";
                }
            }
        }
    }

    protected override async Task OnSesionValidaAsync()
    {
        await CargarEstadisticas();
        _filtrosInicializados = true;
    }

    private async Task OnBuscarInput(ChangeEventArgs e)
    {
        buscarSitio = e.Value?.ToString() ?? string.Empty;
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            await CargarEstadisticas();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnFechaDesdeChanged(ChangeEventArgs e)
    {
        fechaDesdeStr = e.Value?.ToString() ?? string.Empty;
        await OnFiltroServidorChanged();
    }

    private async Task OnFechaHastaChanged(ChangeEventArgs e)
    {
        fechaHastaStr = e.Value?.ToString() ?? string.Empty;
        await OnFiltroServidorChanged();
    }

    private async Task OnFiltroServidorChanged()
    {
        if (!_filtrosInicializados)
            return;

        await CargarEstadisticas();
    }

    private async Task LimpiarFiltros()
    {
        buscarSitio = string.Empty;
        estadoSitioStr = string.Empty;
        fechaDesdeStr = string.Empty;
        fechaHastaStr = string.Empty;
        minUsuariosStr = string.Empty;
        orden = "recaudado";
        await CargarEstadisticas();
    }

    private async Task CargarEstadisticas()
    {
        loading = true;
        error = null;

        try
        {
            EstadisticasApiClient.SetToken(AdminToken!);
            stats = await EstadisticasApiClient.ObtenerGlobalesAsync(CrearFiltroServidor());
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private EstadisticasGlobalesFiltroDto CrearFiltroServidor()
    {
        var filtro = new EstadisticasGlobalesFiltroDto();

        if (DateTime.TryParse(fechaDesdeStr, out var desde))
            filtro.FechaDesde = desde;

        if (DateTime.TryParse(fechaHastaStr, out var hasta))
            filtro.FechaHasta = hasta;

        if (int.TryParse(estadoSitioStr, out var estadoInt) && Enum.IsDefined(typeof(EstadoSitio), estadoInt))
            filtro.EstadoSitio = (EstadoSitio)estadoInt;

        if (!string.IsNullOrWhiteSpace(buscarSitio))
            filtro.Buscar = buscarSitio.Trim();

        return filtro;
    }

    private string ResumenFiltrosActivos()
    {
        var partes = new List<string>();

        if (!string.IsNullOrWhiteSpace(buscarSitio))
            partes.Add($"búsqueda «{buscarSitio.Trim()}»");

        if (int.TryParse(estadoSitioStr, out var estadoInt) && Enum.IsDefined(typeof(EstadoSitio), estadoInt))
            partes.Add($"estado {EtiquetaEstado((EstadoSitio)estadoInt).ToLower()}");

        if (!string.IsNullOrWhiteSpace(fechaDesdeStr))
            partes.Add($"pagos desde {fechaDesdeStr}");

        if (!string.IsNullOrWhiteSpace(fechaHastaStr))
            partes.Add($"pagos hasta {fechaHastaStr}");

        if (MinUsuarios > 0)
            partes.Add($"mín. {MinUsuarios} usuarios");

        return partes.Count == 0
            ? "Sin filtros activos — mostrando todos los sitios."
            : string.Join(" · ", partes);
    }

    private async Task ExportarCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Sitio,Dominio,Estado,Usuarios,Pendientes,Pencas activas,Pencas finalizadas,Inscripciones,Recaudado,Comisiones");

        foreach (var sitio in SitiosTabla)
        {
            sb.Append('"').Append(EscaparCsv(sitio.NombreSitio)).Append('"').Append(',');
            sb.Append('"').Append(EscaparCsv(sitio.UrlPropia)).Append('"').Append(',');
            sb.Append(EtiquetaEstado(sitio.Estado)).Append(',');
            sb.Append(sitio.TotalUsuarios).Append(',');
            sb.Append(sitio.UsuariosPendientes).Append(',');
            sb.Append(sitio.TotalPencasActivas).Append(',');
            sb.Append(sitio.TotalPencasFinalizadas).Append(',');
            sb.Append(sitio.TotalInscripciones).Append(',');
            sb.Append(sitio.TotalRecaudado).Append(',');
            sb.AppendLine(sitio.TotalComisiones.ToString(CultureInfo.InvariantCulture));
        }

        var nombre = $"estadisticas-globales-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        await JS.InvokeVoidAsync("tuPencaAdmin.downloadTextFile", nombre, sb.ToString(), "text/csv;charset=utf-8;");
    }

    private static string EscaparCsv(string valor) => valor.Replace("\"", "\"\"");

    private static string FormatearMoneda(int monto) =>
        monto.ToString("C0", new CultureInfo("es-AR"));

    private static string EtiquetaEstado(EstadoSitio estado) => estado switch
    {
        EstadoSitio.Activo => "Activo",
        EstadoSitio.Inactivo => "Inactivo",
        EstadoSitio.Pendiente => "Pendiente",
        _ => estado.ToString()
    };

    private static string BadgeEstado(EstadoSitio estado) => estado switch
    {
        EstadoSitio.Activo => "badge-success",
        EstadoSitio.Inactivo => "badge-muted",
        EstadoSitio.Pendiente => "badge-warning",
        _ => "badge-muted"
    };

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
