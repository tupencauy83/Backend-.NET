@page "/eventos"
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Evento
@inject EventosApiClient EventosApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<h1>Eventos Deportivos</h1>

<button class="btn btn-primary" @onclick="() => mostrarForm = !mostrarForm">
    @(mostrarForm ? "Cancelar" : "+ Nuevo evento")
</button>

@if (mostrarForm)
{
    <div class="form-card">
        <div class="form-group">
            <label>Nombre</label>
            <input @bind="form.Nombre" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Fecha inicio</label>
                <div style="display:flex;gap:.5rem;">
                    <input type="date" @bind="form.FechaInicio" @bind:format="yyyy-MM-dd" style="flex:1;" />
                    <input type="time" @bind="horaInicio" style="width:120px;" />
                </div>
            </div>

            <div class="form-group">
                <label>Fecha fin</label>
                <div style="display:flex;gap:.5rem;">
                    <input type="date" @bind="form.FechaFin" @bind:format="yyyy-MM-dd" style="flex:1;" />
                    <input type="time" @bind="horaFin" style="width:120px;" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Deporte</label>
            <select @bind="form.DeporteId">
                <option value="@Guid.Empty">Seleccionar...</option>
                @foreach (var d in deportes)
                {
                    <option value="@d.Id">@d.Nombre</option>
                }
            </select>

            <div style="display:flex;gap:.5rem;margin-top:.35rem;">
                <input @bind="nuevoDeporte" placeholder="Nuevo deporte..." style="flex:1;" />
                <button type="button" class="btn" style="background:var(--border);" @onclick="CrearDeporte">+ Crear</button>
            </div>
        </div>

        <div class="form-group">
            <label>Tipo de competencia</label>
            <select @bind="form.TipoCompetenciaId">
                <option value="@Guid.Empty">Seleccionar...</option>
                @foreach (var t in tiposComp)
                {
                    <option value="@t.Id">@t.Nombre</option>
                }
            </select>

            <div style="display:flex;gap:.5rem;margin-top:.35rem;">
                <input @bind="nuevoTipo" placeholder="Nuevo tipo..." style="flex:1;" />
                <button type="button" class="btn" style="background:var(--border);" @onclick="CrearTipo">+ Crear</button>
            </div>
        </div>

        @if (formError != null)
        {
            <p class="error">@formError</p>
        }

        <button class="btn btn-primary" @onclick="Crear" disabled="@saving">
            @(saving ? "Creando..." : "Crear evento")
        </button>
    </div>
}

@if (VerificandoSesion)
{
    <p>Verificando sesión...</p>
}
else if (loading)
{
    <p>Cargando...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in eventos)
            {
                <tr>
                    <td>@ev.Nombre</td>
                    <td>@ev.FechaInicio.ToShortDateString()</td>
                    <td>@ev.FechaFin.ToShortDateString()</td>
                    <td>
                        <a href="/eventos/@ev.Id/resultados" class="btn btn-primary">Resultados</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (eventos.Count == 0)
    {
        <p class="empty">No hay eventos registrados.</p>
    }
}


@code {
    private List<EventoResponseDto> eventos = new();
    private List<CatalogoSimpleDto> deportes = new();
    private List<CatalogoSimpleDto> tiposComp = new();

    private bool loading = true;
    private bool saving = false;
    private bool mostrarForm = false;

    private string? formError;
    private string nuevoDeporte = "";
    private string nuevoTipo = "";

    private TimeOnly horaInicio = TimeOnly.FromDateTime(DateTime.UtcNow.AddHours(-3));
    private TimeOnly horaFin = TimeOnly.FromDateTime(DateTime.UtcNow.AddHours(-3));

    private EventoRequestDto form = new();

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        EventosApiClient.SetToken(AdminToken!);

        eventos = await EventosApiClient.ObtenerTodosAsync();
        deportes = await EventosApiClient.ObtenerDeportesAsync();
        tiposComp = await EventosApiClient.ObtenerTiposCompetenciaAsync();

        loading = false;
    }

    private async Task Crear()
    {
        saving = true;
        formError = null;

        try
        {
            form.FechaInicio = form.FechaInicio.Date.Add(horaInicio.ToTimeSpan());
            form.FechaFin = form.FechaFin.Date.Add(horaFin.ToTimeSpan());

            var nuevo = await EventosApiClient.CrearAsync(form);

            eventos.Add(nuevo);

            form = new();
            horaInicio = TimeOnly.FromDateTime(DateTime.UtcNow.AddHours(-3));
            horaFin = TimeOnly.FromDateTime(DateTime.UtcNow.AddHours(-3));
            mostrarForm = false;
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CrearDeporte()
    {
        if (string.IsNullOrWhiteSpace(nuevoDeporte))
            return;

        var deporte = await EventosApiClient.CrearDeporteAsync(nuevoDeporte.Trim());

        deportes.Add(deporte);
        form.DeporteId = deporte.Id;
        nuevoDeporte = "";
    }

    private async Task CrearTipo()
    {
        if (string.IsNullOrWhiteSpace(nuevoTipo))
            return;

        var tipo = await EventosApiClient.CrearTipoCompetenciaAsync(nuevoTipo.Trim());

        tiposComp.Add(tipo);
        form.TipoCompetenciaId = tipo.Id;
        nuevoTipo = "";
    }
}