@page "/gestion-pencas"
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Penca
@using TuPenca.Admin.Models.Enums
@inject PencasApiClient PencasApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<h1>Pencas en la plataforma</h1>
<p class="text-muted" style="margin-bottom: 1.25rem;">
    Vista de consulta de todas las instancias creadas por los sitios.
</p>

@if (VerificandoSesion || loading)
{
    <p>Cargando...</p>
}
else if (error != null)
{
    <p class="error">@error</p>
    <button class="btn" @onclick="Cargar">Reintentar</button>
}
else
{
    <div class="form-card stats-filtros">
        <div class="stats-filtros__header">
            <div>
                <h2 class="stats-filtros__title">Filtros</h2>
                <p class="stats-filtros__resumen">@ResumenFiltros()</p>
            </div>

            <div class="stats-filtros__actions">
                @if (HayFiltrosActivos)
                {
                    <button type="button"
                            class="btn btn-outline btn-sm"
                            @onclick="LimpiarFiltros">
                        Limpiar
                    </button>
                }
            </div>
        </div>

        <div class="stats-filtros__grid">

            <div class="form-group">
                <label>Nombre</label>
                <input class="public-form-control"
                       placeholder="Buscar penca..."
                       @bind="filtroNombre"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Sitio</label>
                <select @bind="filtroSitio">
                    <option value="">Todos</option>

                    @foreach (var sitio in SitiosDisponibles)
                    {
                        <option value="@sitio">@sitio</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Estado</label>
                <select @bind="filtroEstado">
                    <option value="">Todos</option>

                    @foreach (var estado in Enum.GetValues<EstadoPenca>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>

        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Sitio</th>
                <th>Plantilla</th>
                <th>Evento</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var penca in PencasFiltradas)
            {
                <tr>
                    <td>@penca.Nombre</td>
                    <td>
                        <span>@penca.SitioNombre</span>
                        @if (!string.IsNullOrWhiteSpace(penca.SitioUrl))
                        {
                            <br />
                            <span class="text-muted" style="font-size: .85rem;">@penca.SitioUrl</span>
                        }
                    </td>
                    <td>@penca.PlantillaNombre</td>
                    <td>@penca.EventoDeportivo</td>
                    <td>
                        <span class="badge-@penca.Estado.ToString().ToLower()">
                            @penca.Estado
                        </span>
                    </td>
                    <td>
                        @if (penca.Estado == EstadoPenca.Finalizada)
                        {
                            <button class="btn"
                                    style="background:#64748b;color:#fff;"
                                    @onclick="() => VerGanadores(penca.Id, penca.Nombre)">
                                Ver ganadores
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!PencasFiltradas.Any())
    {
        <p class="empty">No hay pencas que coincidan con los filtros.</p>
    }
}

@if (ganadores != null)
{
    <div class="form-card" style="margin-top: 1.5rem;">
        <h3 style="margin-bottom: 1rem;">
            Ganadores@(pencaGanadoresNombre != null ? $" — {pencaGanadoresNombre}" : "")
        </h3>

        @if (ganadores.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Posición</th>
                        <th>Usuario</th>
                        <th>Premio</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var g in ganadores)
                    {
                        <tr>
                            <td>@g.Posicion°</td>
                            <td>@g.NombreUsuario</td>
                            <td>$@g.Monto</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No hay premios registrados para esta penca.</p>
        }
    </div>
}

@code {
    private List<PencaResponseDto> pencas = new();
    private List<PremioResponseDto>? ganadores;
    private string? pencaGanadoresNombre;

    private bool loading = true;
    private string? error;

    private string filtroNombre = string.Empty;
    private string filtroSitio = string.Empty;
    private string filtroEstado = string.Empty;

    private IEnumerable<PencaResponseDto> PencasFiltradas =>
    pencas.Where(p =>
        (string.IsNullOrWhiteSpace(filtroNombre) || p.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(filtroSitio) || p.SitioNombre.Equals(filtroSitio, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(filtroEstado) || p.Estado.ToString() == filtroEstado)
    );

    private IEnumerable<string> SitiosDisponibles =>
    pencas.Select(p => p.SitioNombre)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s);

    private bool HayFiltrosActivos => 
    !string.IsNullOrWhiteSpace(filtroNombre) ||
    !string.IsNullOrWhiteSpace(filtroSitio) ||
    !string.IsNullOrWhiteSpace(filtroEstado);

    private void LimpiarFiltros()
    {
        filtroNombre = string.Empty;
        filtroSitio = string.Empty;
        filtroEstado = string.Empty;
    }

    private string ResumenFiltros()
    {
        if (!HayFiltrosActivos)
            return $"Mostrando {pencas.Count} penca(s)";

        var filtros = new List<string>();

        if (!string.IsNullOrWhiteSpace(filtroNombre))
            filtros.Add($"Nombre: {filtroNombre}");

        if (!string.IsNullOrWhiteSpace(filtroSitio))
            filtros.Add($"Sitio: {filtroSitio}");

        if (!string.IsNullOrWhiteSpace(filtroEstado))
            filtros.Add($"Estado: {filtroEstado}");

        return string.Join(" | ", filtros);
    }

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        loading = true;
        error = null;

        try
        {
            PencasApiClient.SetToken(AdminToken!);

            pencas = await PencasApiClient.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task VerGanadores(Guid pencaId, string nombrePenca)
    {
        try
        {
            PencasApiClient.SetToken(AdminToken!);

            error = null;
            pencaGanadoresNombre = nombrePenca;
            ganadores = await PencasApiClient.ObtenerGanadoresAsync(pencaId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            ganadores = null;
            pencaGanadoresNombre = null;
        }
    }
}
