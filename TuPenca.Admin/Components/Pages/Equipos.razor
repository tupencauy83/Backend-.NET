@page "/equipos"
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Equipo
@inject EquiposApiClient EquiposApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<h1>Gestión de Equipos</h1>

<p class="stats-filtros__resumen">
    Total: @equipos.Count equipo(s)
</p>

@if (formError != null)
{
    <p class="error">@formError</p>
}

@if (VerificandoSesion || loading)
{
    <p>Cargando...</p>
}
else
{
    <button class="btn btn-primary" @onclick="ToggleFormulario">
        @(mostrarForm ? "Cancelar" : "+ Nuevo equipo")
    </button>

    @if (mostrarForm)
    {
        <div class="form-card">
            <div class="form-group">
            <textarea @bind="nombresTexto" rows="3" placeholder="Un equipo por línea..."></textarea>
            </div>
            <button class="btn btn-primary" @onclick="Crear" disabled="@saving">
                @(saving ? "Creando..." : "+ Agregar equipos")
            </button>
        </div>
    }

    <div class="form-card stats-filtros" style="margin-top:1rem;">
        <div class="stats-filtros__header">
            <div>
                <h2 class="stats-filtros__title">Filtros</h2>
                <p class="stats-filtros__resumen">@ResumenFiltros()</p>
            </div>

            <div class="stats-filtros__actions">
                @if (HayFiltrosActivos)
                {
                    <button type="button"
                            class="btn btn-outline btn-sm"
                            @onclick="LimpiarFiltros">
                        Limpiar
                    </button>
                }
            </div>
        </div>

        <div class="stats-filtros__grid">
            <div class="form-group">
                <label>Nombre</label>
                <input class="public-form-control"
                       placeholder="Buscar equipo..."
                       @bind="filtroNombre"
                       @bind:event="oninput" />
            </div>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr><th>#</th><th>Nombre</th></tr>
        </thead>
        <tbody>
            @{
                var equiposFiltrados = EquiposFiltrados.ToList();
            }

            @for (int i = 0; i < equiposFiltrados.Count; i++)
            {
                var eq = equiposFiltrados[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@eq.Nombre</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!EquiposFiltrados.Any())
    {
        <p class="empty">No hay equipos que coincidan con los filtros.</p>
    }
}

@code {
    private List<EquipoResponseDto> equipos = new();
    private bool loading = true;
    private bool saving = false;
    private string nombresTexto = "";
    private string? formError;

    private bool mostrarForm = false;

    private string filtroNombre = string.Empty;

    private IEnumerable<EquipoResponseDto> EquiposFiltrados =>
    equipos.Where(e =>
        string.IsNullOrWhiteSpace(filtroNombre) 
        || e.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase));

    private bool HayFiltrosActivos =>
        !string.IsNullOrWhiteSpace(filtroNombre);

    private string ResumenFiltros()
    {
        if (!HayFiltrosActivos)
            return $"Mostrando {equipos.Count} equipo(s)";

        return $"Nombre: {filtroNombre}";
    }

    private void LimpiarFiltros()
    {
        filtroNombre = string.Empty;
    }

    private void ToggleFormulario()
    {
        mostrarForm = !mostrarForm;
        if (mostrarForm)
            LimpiarFiltros();
    }

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        EquiposApiClient.SetToken(AdminToken!);
        var result = await EquiposApiClient.ObtenerTodosAsync();
        equipos = result.ToList();
        loading = false;
    }

    private async Task Crear()
    {
        var nombres = nombresTexto.Split('\n')
            .Select(n => n.Trim())
            .Where(n => !string.IsNullOrEmpty(n))
            .ToList();

        if (nombres.Count == 0) { formError = "Ingresá al menos un nombre"; return; }

        saving = true; formError = null;
        try
        {
            var nuevos = await EquiposApiClient.CrearVariosAsync(new EquipoRequestDto { Nombres = nombres });
            equipos.AddRange(nuevos);
            nombresTexto = "";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; }
    }
}