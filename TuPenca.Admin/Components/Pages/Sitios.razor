@page "/sitios"
@using TuPenca.Admin.Models.Enums
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Sitio
@inject SitiosApiClient SitiosApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<h1>Gestión de Sitios</h1>

@if (VerificandoSesion || loading)
{
    <p>Cargando...</p>
}
else if (error != null)
{
    <p class="error">@error</p>
    <button class="btn" @onclick="Cargar">Reintentar</button>
}
else
{
    <div class="form-card stats-filtros">
        <div class="stats-filtros__header">
            <div>
                <h2 class="stats-filtros__title">Filtros</h2>
                <p class="stats-filtros__resumen">@ResumenFiltros()</p>
            </div>

            <div class="stats-filtros__actions">
                @if (HayFiltrosActivos)
                {
                    <button type="button"
                            class="btn btn-outline btn-sm"
                            @onclick="LimpiarFiltros">
                        Limpiar
                    </button>
                }
            </div>
        </div>

        <div class="stats-filtros__grid">
            <div class="form-group">
                <label>Nombre</label>
                <input class="public-form-control"
                       placeholder="Buscar sitio..."
                       @bind="filtroNombre"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label>Estado</label>
                <select @bind="filtroEstado">
                    <option value="">Todos</option>

                    @foreach (var estado in Enum.GetValues<EstadoSitio>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>URL</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sitio in SitiosFiltrados)
            {
                <tr>
                    <td>@sitio.Nombre</td>
                    <td>@sitio.UrlPropia</td>
                    <td>@sitio.Estado</td>
                    <td>
                        @if (sitio.Estado == EstadoSitio.Pendiente)
                        {
                            <button class="btn btn-primary" @onclick="() => Aprobar(sitio.Id)">Aprobar</button>
                            <button class="btn" style="background:#64748b;color:#fff;margin-left:.5rem;" @onclick="() => Rechazar(sitio.Id)">Rechazar</button>
                        }
                        <button class="btn btn-danger" style="margin-left:.5rem;" @onclick="() => Eliminar(sitio.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!SitiosFiltrados.Any())
    {
        <p class="empty">No hay sitios que coincidan con los filtros.</p>
    }
}

@code {
    private List<SitioRequestDto> sitios = new();
    private bool loading = true;
    private string? error;

    private string filtroNombre = string.Empty;
    private string filtroEstado = string.Empty;

    private IEnumerable<SitioRequestDto> SitiosFiltrados =>
        sitios.Where(s =>
            (string.IsNullOrWhiteSpace(filtroNombre) || s.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(filtroEstado) || s.Estado.ToString() == filtroEstado)
        );

    private bool HayFiltrosActivos =>
     !string.IsNullOrWhiteSpace(filtroNombre) ||
     !string.IsNullOrWhiteSpace(filtroEstado);

    private string ResumenFiltros()
    {
        if (!HayFiltrosActivos)
            return "Mostrando todos los sitios";

        var filtros = new List<string>();

        if (!string.IsNullOrWhiteSpace(filtroNombre))
            filtros.Add($"Nombre: {filtroNombre}");

        if (!string.IsNullOrWhiteSpace(filtroEstado))
            filtros.Add($"Estado: {filtroEstado}");

        return string.Join(" | ", filtros);
    }

    private void LimpiarFiltros()
    {
        filtroNombre = string.Empty;
        filtroEstado = string.Empty;
    }

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        loading = true; error = null;
        try
        {
            SitiosApiClient.SetToken(AdminToken!);
            var result = await SitiosApiClient.ObtenerTodosAsync();
            sitios = result.ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Eliminar(Guid id)
    {
        try
        {
            await SitiosApiClient.EliminarAsync(id);
            sitios.RemoveAll(s => s.Id == id);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Aprobar(Guid id)
    {
        try
        {
            var response = await SitiosApiClient.AprobarAsync(id);
            if (response.Mensaje.Contains("no encontrado", StringComparison.OrdinalIgnoreCase))
                error = response.Mensaje;
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Rechazar(Guid id)
    {
        try
        {
            var response = await SitiosApiClient.RechazarAsync(id);
            if (response.Mensaje.Contains("no encontrado", StringComparison.OrdinalIgnoreCase))
                error = response.Mensaje;
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
