@page "/sitios"
@using TuPenca.Application.Interfaces.Services
@using TuPenca.Application.DTOs.Sitio
@using TuPenca.Infrastructure.Services
@using TuPenca.Domain.Enums
@inject ISitioService SitioService
@inject IUsuarioService UsuarioService
@inject IEmailService EmailService
@rendermode InteractiveServer

<h1>Gestión de Sitios</h1>

@if (loading)
{
    <p>Cargando...</p>
}
else if (error != null)
{
    <p class="error">@error</p>
    <button class="btn" @onclick="Cargar">Reintentar</button>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>URL</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sitio in sitios)
            {
                <tr>
                    <td>@sitio.Nombre</td>
                    <td>@sitio.UrlPropia</td>
                    <td>@sitio.Estado</td>
                    <td>
                        @if (sitio.Estado == TuPenca.Domain.Enums.EstadoSitio.Pendiente)
                        {
                            <button class="btn btn-primary" @onclick="() => Aprobar(sitio.Id)">Aprobar</button>
                            <button class="btn" style="background:#64748b;color:#fff;margin-left:.5rem;" @onclick="() => Rechazar(sitio.Id)">Rechazar</button>
                        }
                        <button class="btn btn-danger" style="margin-left:.5rem;" @onclick="() => Eliminar(sitio.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (sitios.Count == 0)
    {
        <p class="empty">No hay sitios registrados.</p>
    }
}

@code {
    private List<SitioDto> sitios = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        loading = true; error = null;
        try
        {
            var result = await SitioService.ObtenerSitiosAsync();
            sitios = result.ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Eliminar(Guid id)
    {
        try
        {
            await SitioService.EliminarSitioAsync(id);
            sitios.RemoveAll(s => s.Id == id);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Aprobar(Guid id)
    {
        try
        {
            var sitio = await SitioService.ObtenerSitioAsync(id);
            if (sitio == null)
            {
                error = "Sitio no encontrado";
                return;
            }

            await SitioService.ActualizarSitioPendienteAsync(new SitioActualizarEstadoRequest 
            { 
                Id = id, 
                Estado = TuPenca.Domain.Enums.EstadoSitio.Activo 
            });
            // Aprobar también al admin del sitio
            var usuarios = await UsuarioService.ObtenerUsuariosAsync();
            var adminSitio = usuarios.FirstOrDefault(u => u.SitioId == id);
            if (adminSitio != null && adminSitio.Estado == TuPenca.Domain.Enums.EstadoUsuario.Pendiente)
            {
                await UsuarioService.ActualizarEstadoAsync(new TuPenca.Application.DTOs.Usuario.UsuarioActualizarEstadoRequestDto
                {
                    Id = adminSitio.Id,
                    Estado = TuPenca.Domain.Enums.EstadoUsuario.Aprobado
                });

                var password = Guid.NewGuid().ToString()[..8];
                await UsuarioService.ActualizarPasswordAsync(new TuPenca.Application.DTOs.Usuario.UsuarioActualizarPasswordRequestDto
                {
                    Id = adminSitio.Id,
                    Password = password,
                    PasswordConfirm = password
                });

                await EmailService.EnviarAsync(
                    adminSitio.Email,
                    "Bienvenido a TuPenca - Credenciales de tu sitio",
                    $@"<h2>¡Tu sitio fue aprobado!</h2>
                    <p>Hola {adminSitio.Nombre},</p>
                    <p>Tu sitio <strong>{sitio.Nombre}</strong> fue aprobado exitosamente.</p>
                    <p>Tus credenciales de acceso como administrador del sitio:</p>
                    <ul>
                        <li><strong>Email:</strong> {adminSitio.Email}</li>
                        <li><strong>Contraseña:</strong> {password}</li>
                    </ul>
                    <p>Te recomendamos cambiar la contraseña después del primer inicio de sesión.</p>
                    <p>— Equipo TuPenca</p>"
                );
            }
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Rechazar(Guid id)
    {
        try
        {
            var sitio = await SitioService.ObtenerSitioAsync(id);
            if (sitio == null)
            {
                error = "Sitio no encontrado";
                return;
            }

            await SitioService.ActualizarSitioPendienteAsync(new SitioActualizarEstadoRequest 
            { 
                Id = id, 
                Estado = TuPenca.Domain.Enums.EstadoSitio.Inactivo 
            });

            var usuarios = await UsuarioService.ObtenerUsuariosAsync();
            var adminSitio = usuarios.FirstOrDefault(u => u.SitioId == id);
            if (adminSitio != null)
            {
                await UsuarioService.ActualizarEstadoAsync(new TuPenca.Application.DTOs.Usuario.UsuarioActualizarEstadoRequestDto
                {
                    Id = adminSitio.Id,
                    Estado = TuPenca.Domain.Enums.EstadoUsuario.Rechazado
                });

                await EmailService.EnviarAsync(
                    adminSitio.Email,
                    "Tu sitio fue rechazado",
                    $@"<h2>Solicitud de sitio rechazada</h2>
                    <p>Hola {adminSitio.Nombre},</p>
                    <p>Lamentamos informarte que tu solicitud para el sitio <strong>{sitio.Nombre}</strong> fue rechazada.</p>
                    <p>Si creés que fue un error, podés volver a comunicarte con el equipo de TuPenca.</p>
                    <p>— Equipo TuPenca</p>"
                );
            }
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
