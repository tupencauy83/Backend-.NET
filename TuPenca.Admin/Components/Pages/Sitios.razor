@page "/sitios"
@using TuPenca.Admin.Models.Enums
@using TuPenca.Admin.Services
@using TuPenca.Admin.DTOs.Sitio
@inject SitiosApiClient SitiosApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<h1>Gestión de Sitios</h1>

@if (VerificandoSesion || loading)
{
    <p>Cargando...</p>
}
else if (error != null)
{
    <p class="error">@error</p>
    <button class="btn" @onclick="Cargar">Reintentar</button>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>URL</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sitio in sitios)
            {
                <tr>
                    <td>@sitio.Nombre</td>
                    <td>@sitio.UrlPropia</td>
                    <td>@sitio.Estado</td>
                    <td>
                        @if (sitio.Estado == EstadoSitio.Pendiente)
                        {
                            <button class="btn btn-primary" @onclick="() => Aprobar(sitio.Id)">Aprobar</button>
                            <button class="btn" style="background:#64748b;color:#fff;margin-left:.5rem;" @onclick="() => Rechazar(sitio.Id)">Rechazar</button>
                        }
                        <button class="btn btn-danger" style="margin-left:.5rem;" @onclick="() => Eliminar(sitio.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (sitios.Count == 0)
    {
        <p class="empty">No hay sitios registrados.</p>
    }
}

@code {
    private List<SitioRequestDto> sitios = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnSesionValidaAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        loading = true; error = null;
        try
        {
            SitiosApiClient.SetToken(AdminToken!);
            var result = await SitiosApiClient.ObtenerTodosAsync();
            sitios = result.ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Eliminar(Guid id)
    {
        try
        {
            await SitiosApiClient.EliminarAsync(id);
            sitios.RemoveAll(s => s.Id == id);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Aprobar(Guid id)
    {
        try
        {
            var response = await SitiosApiClient.AprobarAsync(id);
            if (response.Mensaje.Contains("no encontrado", StringComparison.OrdinalIgnoreCase))
                error = response.Mensaje;
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Rechazar(Guid id)
    {
        try
        {
            var response = await SitiosApiClient.RechazarAsync(id);
            if (response.Mensaje.Contains("no encontrado", StringComparison.OrdinalIgnoreCase))
                error = response.Mensaje;
            await Cargar();
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
