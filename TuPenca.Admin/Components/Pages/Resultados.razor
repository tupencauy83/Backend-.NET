@page "/eventos/{EventoId:guid}/resultados"
@using TuPenca.Admin.Helpers
@using TuPenca.Admin.DTOs.Evento
@using TuPenca.Admin.DTOs.Equipo
@using TuPenca.Admin.DTOs.Partido
@using TuPenca.Admin.Services
@inject EventosApiClient EventosApiClient
@inject EquiposApiClient EquiposApiClient
@inherits AdminProtectedPage
@rendermode InteractiveServer

<div class="workflow-page">
    @if (!VerificandoSesion && evento != null)
    {
        <p class="workflow-breadcrumb">
            <a href="/eventos">Competencias</a> ·
            <span>@evento.Nombre</span> · Paso 2 de 3
        </p>
    }
    else
    {
        <p class="workflow-breadcrumb">
            <a href="/eventos">Competencias</a> · Paso 2 de 3
        </p>
    }

    <h1>Partidos y resultados</h1>

    @if (evento != null)
    {
        <CompetenciaFlujoStepper PasoActual="2" EventoId="EventoId" EventoNombre="@evento.Nombre" />
    }

    @if (EsFlujoNuevo)
    {
        <div class="workflow-banner">
            <strong>Evento creado.</strong> Ahora cargá los partidos del fixture.
            @if (equipos.Count == 0)
            {
                <span> Primero necesitás equipos en la sección <a href="/equipos">Equipos</a>.</span>
            }
        </div>
    }

@if (VerificandoSesion)
{
    <p>Cargando...</p>
}
else
{
    <button class="btn btn-primary" style="margin-bottom:1rem;" @onclick="() => mostrarFormPartido = !mostrarFormPartido">
        @(mostrarFormPartido ? "Cancelar" : "+ Agregar partido")
    </button>

    @if (mostrarFormPartido)
    {
        <div class="form-card">
            <h2 class="stats-section-title">Paso 2 · Agregar partido</h2>

            @if (equipos.Count == 0)
            {
                <p class="error">
                    No hay equipos cargados.
                    <a href="/equipos">Creá equipos</a> antes de armar el fixture.
                </p>
            }

            <div class="form-group">
                <label>Fecha y hora (Uruguay)</label>
                <div style="display:flex;gap:.5rem;">
                    <input type="date" value="@fechaPartidoStr" @onchange="OnFechaPartidoChanged" style="flex:1;" />
                    <input type="time" @bind="horaPartido" style="width:120px;" />
                </div>
            </div>

            <div class="form-group">
                <label>Fase</label>
                <input @bind="nuevoPartido.Fase" placeholder="Ej: Grupo A, Semifinal..." />
            </div>

            <div class="form-group">
                <label>Id partido API (TheSportsDB)</label>
                <input @bind="nuevoPartido.ExternalMatchId" placeholder="Opcional - Ej: 2267073" />
                <span style="font-size:.75rem;color:var(--muted);">
                    Permite actualizar resultados automáticamente.
                </span>
            </div>

            <div class="form-group">
                <label>Equipo local</label>
                <select @bind="nuevoPartido.EquipoLocalId">
                    <option value="@Guid.Empty">Seleccionar...</option>
                    @foreach (var eq in equipos)
                    {
                        <option value="@eq.Id">@eq.Nombre</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Equipo visitante</label>
                <select @bind="nuevoPartido.EquipoVisitanteId">
                    <option value="@Guid.Empty">Seleccionar...</option>
                    @foreach (var eq in equipos)
                    {
                        <option value="@eq.Id">@eq.Nombre</option>
                    }
                </select>
            </div>

            @if (partidoError != null)
            {
                <p class="error">@partidoError</p>
            }

            <button class="btn btn-primary" @onclick="AgregarPartido" disabled="@savingPartido">
                @(savingPartido ? "Guardando..." : "Agregar partido")
            </button>
        </div>
    }

    @if (loading)
    {
        <p>Cargando...</p>
    }
    else if (error != null)
    {
        <p class="error">@error</p>
    }
    else if (evento != null)
    {
        <h2 style="font-size: 1.1rem; color: var(--muted); margin-bottom: 1.5rem;">
            @evento.Nombre
        </h2>

        <div class="form-card stats-filtros">
            <div class="stats-filtros__header">
                <div>
                    <h2 class="stats-filtros__title">Filtros</h2>
                    <p class="stats-filtros__resumen">@ResumenFiltros()</p>
                </div>

                <div class="stats-filtros__actions">
                    @if (HayFiltrosActivos)
                    {
                        <button type="button"
                                class="btn btn-outline btn-sm"
                                @onclick="LimpiarFiltros">
                            Limpiar
                        </button>
                    }
                </div>
            </div>

            <div class="stats-filtros__grid">

                <div class="form-group">
                    <label>Equipo</label>
                    <input class="public-form-control"
                            placeholder="Buscar equipo..."
                            @bind="filtroEquipo"
                            @bind:event="oninput" />
                </div>

                <div class="form-group">
                    <label>Fase</label>
                    <input class="public-form-control"
                            placeholder="Ej: Grupo A"
                            @bind="filtroFase"
                            @bind:event="oninput" />
                </div>

                <div class="form-group">
                    <label>Fecha</label>
                        <input type="date"
                               class="public-form-control"
                               @bind="filtroFecha" />
                </div>

            </div>
        </div>

        @if (!PartidosFiltrados.Any())
        {
            <p class="empty">
                No hay partidos que coincidan con los filtros seleccionados.
            </p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Partido</th>
                        <th>Fase</th>
                        <th>Fecha</th>
                        <th>Resultado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var partido in PartidosFiltrados)
                    {
                        var yaJugado = partido.ResultadoLocal != null;

                        <tr>
                            <td>@partido.EquipoLocal vs @partido.EquipoVisitante</td>
                            <td>@partido.Fase</td>
                            <td>@UruguayTimeHelper.Formatear(partido.Fecha)</td>
                            <td>
                                @if (yaJugado)
                                {
                                    <strong>@partido.ResultadoLocal - @partido.ResultadoVisitante</strong>
                                }
                                else
                                {
                                    <span style="color: var(--muted);">Pendiente</span>
                                }
                            </td>
                            <td>
                                @if (!yaJugado)
                                {
                                    <button class="btn btn-primary" @onclick="() => AbrirForm(partido)">
                                        Cargar resultado
                                    </button>
                                }
                                else
                                {
                                    <button class="btn" style="background:#64748b;color:#fff;" @onclick="() => AbrirForm(partido)">
                                        Modificar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (partidoSeleccionado != null)
        {
            <div class="form-card" style="margin-top: 1.5rem;">
                <h3 style="margin-bottom: 1rem;">
                    @partidoSeleccionado.EquipoLocal vs @partidoSeleccionado.EquipoVisitante
                </h3>

                <div class="form-row">
                    <div class="form-group">
                        <label>Goles @partidoSeleccionado.EquipoLocal</label>
                        <input type="number" min="0" @bind="golesLocal" />
                    </div>

                    <div class="form-group">
                        <label>Goles @partidoSeleccionado.EquipoVisitante</label>
                        <input type="number" min="0" @bind="golesVisitante" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Ganador del partido</label>
                    <select @bind="equipoGanadorId">
                        <option value="">Empate sin penales</option>
                        <option value="@partidoSeleccionado.EquipoLocalId">@partidoSeleccionado.EquipoLocal</option>
                        <option value="@partidoSeleccionado.EquipoVisitanteId">@partidoSeleccionado.EquipoVisitante</option>
                    </select>
                    <span style="font-size:.75rem;color:var(--muted);">
                        Si fue empate con penales, seleccioná quién ganó.
                    </span>
                </div>

                @if (formError != null)
                {
                    <p class="error">@formError</p>
                }

                @if (exito != null)
                {
                    <p style="color: green; font-size: .85rem;">@exito</p>
                }

                <div style="display: flex; gap: .75rem;">
                    <button class="btn btn-primary" @onclick="CargarResultado" disabled="@saving">
                        @(saving ? "Guardando..." : "Guardar resultado")
                    </button>

                    <button class="btn" style="background: var(--border);" @onclick="() => partidoSeleccionado = null">
                        Cancelar
                    </button>
                </div>
            </div>
        }
    }

    @if (evento != null)
    {
        <div class="workflow-footer-cta">
            <p>
                @if ((evento.Partidos?.Count ?? 0) == 0)
                {
                    <text>Cuando tengas al menos un partido, podés definir la plantilla de penca.</text>
                }
                else
                {
                    <text>Siguiente paso: configurá reglas, monto y comisión en la plantilla.</text>
                }
            </p>
            <a href="/plantillas?eventoId=@EventoId" class="btn btn-primary">
                Continuar con plantilla →
            </a>
        </div>
    }

    <div style="margin-top: 1rem;">
        <a href="/eventos" style="color: var(--primary);">← Volver a competencias</a>
    </div>
}
</div>

@code {
    [Parameter] public Guid EventoId { get; set; }

    [SupplyParameterFromQuery(Name = "nuevo")]
    public bool EsFlujoNuevo { get; set; }

    private EventoResponseDto? evento;
    private List<EquipoResponseDto> equipos = new();

    private bool loading = true;
    private string? error;

    private PartidoResponseDto? partidoSeleccionado;
    private int golesLocal = 0;
    private int golesVisitante = 0;
    private string equipoGanadorId = "";
    private bool saving = false;
    private string? formError;
    private string? exito;

    private bool mostrarFormPartido = false;
    private bool savingPartido = false;
    private string? partidoError;
    private TimeOnly horaPartido = TimeOnly.FromDateTime(UruguayTimeHelper.NowInUruguay());
    private string fechaPartidoStr = UruguayTimeHelper.HoyComoInputDate();
    private PartidoRequestDto nuevoPartido = new();

    private string filtroEquipo = string.Empty;
    private string filtroFase = string.Empty;
    private DateTime? filtroFecha;

    private IEnumerable<PartidoResponseDto> PartidosFiltrados =>
    evento?.Partidos?.Where(p =>
        (string.IsNullOrWhiteSpace(filtroEquipo)
            || p.EquipoLocal.Contains(filtroEquipo, StringComparison.OrdinalIgnoreCase)
            || p.EquipoVisitante.Contains(filtroEquipo, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(filtroFase) || p.Fase.Contains(filtroFase, StringComparison.OrdinalIgnoreCase))
        && ( filtroFecha == null || p.Fecha.Date == filtroFecha.Value.Date)
    ) ?? Enumerable.Empty<PartidoResponseDto>();

    private bool HayFiltrosActivos => 
    !string.IsNullOrWhiteSpace(filtroEquipo)
    || !string.IsNullOrWhiteSpace(filtroFase)
    || filtroFecha != null;

    private void LimpiarFiltros()
    {
        filtroEquipo = string.Empty;
        filtroFase = string.Empty;
        filtroFecha = null;
    }

    private string ResumenFiltros()
    {
        if (!HayFiltrosActivos)
            return "Mostrando todos los partidos";

        var filtros = new List<string>();

        if (!string.IsNullOrWhiteSpace(filtroEquipo))
            filtros.Add($"Equipo: {filtroEquipo}");

        if (!string.IsNullOrWhiteSpace(filtroFase))
            filtros.Add($"Fase: {filtroFase}");

        if (filtroFecha != null)
            filtros.Add($"Fecha: {filtroFecha:dd/MM/yyyy}");

        return string.Join(" | ", filtros);
    }

    protected override async Task OnSesionValidaAsync()
    {
        if (EsFlujoNuevo)
            mostrarFormPartido = true;

        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            EventosApiClient.SetToken(AdminToken!);
            EquiposApiClient.SetToken(AdminToken!);

            evento = await EventosApiClient.ObtenerDetalleAsync(EventoId);

            if (evento == null)
            {
                error = "Evento no encontrado.";
                return;
            }

            equipos = await EquiposApiClient.ObtenerTodosAsync();

            nuevoPartido.EventoDeportivoId = EventoId;
            fechaPartidoStr = UruguayTimeHelper.HoyComoInputDate();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFechaPartidoChanged(ChangeEventArgs e) =>
        fechaPartidoStr = e.Value?.ToString() ?? fechaPartidoStr;

    private async Task AgregarPartido()
    {
        savingPartido = true;
        partidoError = null;

        try
        {
            if (nuevoPartido.EquipoLocalId == Guid.Empty)
            {
                partidoError = "Seleccioná el equipo local.";
                return;
            }

            if (nuevoPartido.EquipoVisitanteId == Guid.Empty)
            {
                partidoError = "Seleccioná el equipo visitante.";
                return;
            }

            if (nuevoPartido.EquipoLocalId == nuevoPartido.EquipoVisitanteId)
            {
                partidoError = "El equipo local y visitante no pueden ser el mismo.";
                return;
            }

            nuevoPartido.EventoDeportivoId = EventoId;

            if (!DateTime.TryParse(fechaPartidoStr, out var fechaPartido))
            {
                partidoError = "Ingresá una fecha válida.";
                return;
            }

            nuevoPartido.Fecha = fechaPartido.Date.Add(horaPartido.ToTimeSpan());

            var nuevo = await EventosApiClient.AgregarPartidoAsync(nuevoPartido);

            evento!.Partidos ??= new();
            evento.Partidos.Add(nuevo);

            nuevoPartido = new PartidoRequestDto
            {
                EventoDeportivoId = EventoId
            };

            fechaPartidoStr = UruguayTimeHelper.HoyComoInputDate();
            horaPartido = TimeOnly.FromDateTime(UruguayTimeHelper.NowInUruguay());
            mostrarFormPartido = false;
        }
        catch (Exception ex)
        {
            partidoError = ex.Message;
        }
        finally
        {
            savingPartido = false;
        }
    }

    private void AbrirForm(PartidoResponseDto partido)
    {
        partidoSeleccionado = partido;
        golesLocal = partido.ResultadoLocal ?? 0;
        golesVisitante = partido.ResultadoVisitante ?? 0;
        equipoGanadorId = "";
        formError = null;
        exito = null;
    }

    private async Task CargarResultado()
    {
        if (partidoSeleccionado == null)
            return;

        saving = true;
        formError = null;
        exito = null;

        try
        {
            Guid? ganadorFinal = null;

            if (!string.IsNullOrWhiteSpace(equipoGanadorId))
            {
                ganadorFinal = Guid.Parse(equipoGanadorId);
            }
            else if (golesLocal > golesVisitante)
            {
                ganadorFinal = partidoSeleccionado.EquipoLocalId;
            }
            else if (golesVisitante > golesLocal)
            {
                ganadorFinal = partidoSeleccionado.EquipoVisitanteId;
            }

            var resultado = await EventosApiClient.CargarResultadoAsync(new ResultadoRequestDto
            {
                PartidoId = partidoSeleccionado.Id,
                GolesLocal = golesLocal,
                GolesVisitante = golesVisitante,
                EquipoGanadorId = ganadorFinal
            });

            var idx = evento!.Partidos!.FindIndex(p => p.Id == partidoSeleccionado.Id);

            if (idx >= 0)
            {
                evento.Partidos[idx].ResultadoLocal = golesLocal;
                evento.Partidos[idx].ResultadoVisitante = golesVisitante;
            }

            exito = $"Resultado guardado. {resultado.UsuariosActualizados} usuario(s) actualizados.";
            partidoSeleccionado = null;
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}